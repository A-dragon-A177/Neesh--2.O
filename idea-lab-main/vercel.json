{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Permissions-Policy", "value": "camera=self, microphone=self, geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://sdk.cashfree.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.cashfree.com https://sandbox.cashfree.com https://generativelanguage.googleapis.com https://api.openai.com; frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug*",
      "destination": "/api/ssr?slug=:slug*"
    },
    {
      "source": "/ideas",
      "destination": "/api/ideas-ssr"
    },
    {
      "source": "/ideas/:category",
      "destination": "/api/ideas-ssr?category=:category"
    },
    {
      "source": "/(features|pricing|space|pitches|spotlight-info|simulation|login|signup)",
      "destination": "/api/static-ssr?route=$1"
    },
    {
      "source": "/sitemap-core.xml",
      "destination": "/api/sitemap-core"
    },
    {
      "source": "/sitemap-ideas.xml",
      "destination": "/api/sitemap-ideas"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-core"
    },
    {
      "source": "/sitemap-explorers.xml",
      "destination": "/api/sitemap-explorers"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}