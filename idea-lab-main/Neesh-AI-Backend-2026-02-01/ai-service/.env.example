# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key

# ─── API Key Encryption ──────────────────────────────────
# Used to encrypt/decrypt user-provided LLM API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=generate-a-random-32-byte-hex-string

# ─── LLM API Keys ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key

# ─── Internal Service Auth ────────────────────────────────
# Shared secret between Spring Boot backend and AI-service.
AI_SERVICE_INTERNAL_API_KEY=your-internal-secret

# ─── Server Configuration ────────────────────────────────
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:7000

# ─── Optional: Redis Cache ────────────────────────────────
# If not set, falls back to in-memory cache.
# REDIS_URL=redis://localhost:6379