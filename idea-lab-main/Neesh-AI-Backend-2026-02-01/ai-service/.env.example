# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=your-anon-key

# ─── API Key Encryption ──────────────────────────────────
# Used to encrypt/decrypt user-provided LLM API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=generate-a-random-32-byte-hex-string

# ─── LLM API Keys ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key

# ─── Internal Service Auth ────────────────────────────────
# Shared secret between Spring Boot backend and AI-service.
AI_SERVICE_INTERNAL_API_KEY=your-internal-secret

# ─── Server Configuration ────────────────────────────────
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:7000

# ─── Optional: Redis Cache ────────────────────────────────
# If not set, falls back to in-memory cache.
# REDIS_URL=redis://localhost:6379

# ─── Cashfree Payment Gateway ────────────────────────────
# Required for the Cashfree PG integration (sprint sessions, direct requests).
# Sandbox keys from: https://sandbox.cashfree.com/merchant/settings/developer
# Production keys from: https://merchant.cashfree.com/settings/developer
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
# Set to "sandbox" for test mode, "production" for live payments.
CASHFREE_ENV=sandbox
# Webhook secret configured in Cashfree Dashboard → Developers → Webhooks.
# If not set, falls back to CASHFREE_SECRET_KEY (not recommended for production).
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# ─── Admin Authentication ─────────────────────────────────
# Required for the /api/admin/* endpoints.
# Generate ADMIN_TOKEN_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=generate-a-random-32-byte-hex-string
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-secure-admin-password